{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoverse3d.example/schemas/vehicle.schema.json",
  "title": "Vehicle catalogue",
  "type": "object",
  "required": ["schemaVersion", "contentVersion", "vehicles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentVersion": { "type": "string" },
    "vehicles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/vehicle" } }
  },
  "$defs": {
    "vehicle": {
      "type": "object",
      "required": ["id", "name", "category", "description", "assetManifestId", "featureIds", "availability", "schemaVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "categoryLabel": { "type": "string" },
        "description": { "type": "string" },
        "assetManifestId": { "type": ["string", "null"] },
        "featureIds": { "type": "array", "items": { "enum": ["exterior", "interior", "mechanical", "safety", "customization", "ev"] } },
        "availability": { "enum": ["available", "coming_soon"] },
        "specs": { "type": "array", "items": { "type": "object", "required": ["label", "value"], "properties": { "label": { "type": "string" }, "value": { "type": "string" } } } },
        "specsDisclaimer": { "type": "string" },
        "schemaVersion": { "const": 1 }
      }
    }
  }
}
