{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoverse3d.example/schemas/asset_registry.schema.json",
  "title": "Asset licence registry (machine-readable mirror of ASSET_LICENSING.md)",
  "type": "object",
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "records": { "type": "array", "items": {
      "type": "object",
      "required": ["recordId", "assetId", "files", "title", "creator", "origin", "sourceUrl", "createdOrDownloadedDate", "licence", "commercialUse", "modificationAllowed", "attribution", "restrictions", "checksums", "reviewer", "approvalDate", "status"],
      "properties": {
        "recordId": { "type": "string" },
        "assetId": { "type": "string" },
        "files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "title": { "type": "string" }, "creator": { "type": "string" },
        "origin": { "enum": ["original", "third_party"] },
        "sourceUrl": { "type": "string" },
        "createdOrDownloadedDate": { "type": "string", "format": "date" },
        "licence": { "type": "object", "required": ["name", "termsReference"], "properties": { "name": { "type": "string" }, "termsReference": { "type": "string" } } },
        "commercialUse": { "type": "boolean" },
        "modificationAllowed": { "type": "boolean" },
        "attribution": { "type": "object", "required": ["required", "text", "placement"], "properties": { "required": { "type": "boolean" }, "text": { "type": "string" }, "placement": { "type": "string" } } },
        "restrictions": { "type": "string" },
        "checksums": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
        "reviewer": { "type": "string" },
        "approvalDate": { "type": ["string", "null"] },
        "status": { "enum": ["pending_review", "approved", "rejected", "withdrawn"] }
      }
    }}
  }
}
