# Copy to .env (never commit .env). The mobile apps never see these values.
PORT=8787
# "anthropic" or "mock" (mock = offline, grounded extractive answers; default when no key is set)
AI_PROVIDER=mock
# Anthropic credentials are resolved by the SDK (ANTHROPIC_API_KEY or an `ant auth login` profile)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
# Requests per minute per client (token bucket) for the AI endpoint
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_QUESTION_CHARS=500
